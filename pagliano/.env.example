# Pagliano Law App — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# Email notifications (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Studio Pagliano
ADMIN_EMAIL=your_admin_email_here

# JWT (for admin routes)
JWT_SECRET_KEY=change-me-in-production

# Google Calendar (optional, for appointment booking)
# Generate at https://cloud.google.com/console
# Scope: https://www.googleapis.com/auth/calendar.events only
GOOGLE_CLIENT_SECRET_PATH=/path/to/google_client_secret.json
